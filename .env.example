# Copy to .env (git-ignored) and fill in. Variables already set in the shell take precedence.

# HuggingFace id of the model served by every provider (tokenizer + result labels).
BENCH_MODEL_HF_ID=deepseek-ai/DeepSeek-R1-0528
# Needed for gated tokenizers.
HF_TOKEN=

# Baseten dedicated deployment
BASETEN_API_KEY=
BASETEN_MODEL_ID=
BASETEN_SERVED_MODEL_NAME=
BASETEN_GPU_TYPE=B200
BASETEN_TOTAL_GPUS=8

# Fireworks dedicated deployment
FIREWORKS_API_KEY=
FIREWORKS_SERVED_MODEL_NAME=
FIREWORKS_GPU_TYPE=B200
FIREWORKS_TOTAL_GPUS=8

# Internal infrastructure (OpenAI-compatible endpoint)
INTERNAL_BASE_URL=
INTERNAL_SERVED_MODEL_NAME=
INTERNAL_API_KEY=
INTERNAL_GPU_TYPE=B200
INTERNAL_TOTAL_GPUS=8
